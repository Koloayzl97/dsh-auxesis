{
  "name": "dsh-auxesis",
  "version": "0.9.1",
  "description": "Auxesis（能力增益）：勾选已有模型路由，把「答错会返工」的关键一步交给更强的一路倒推，并把每次的瓶颈模式沉淀下来供下一次复用。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client.js",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "auxesis",
    "reverse-thinking",
    "能力增益"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/core.test.mjs test/quality.test.mjs",
    "summary": "node scripts/summary.mjs"
  }
}
